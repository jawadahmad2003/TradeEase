{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TradeEaseDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "ForexApi": {
    "BaseUrl": "https://open.er-api.com/v6/",
    "RefreshIntervalMinutes": 5
  },
  "ReportingApi": {
    "BaseUrl": "http://localhost:5210/"
  },
  "LiveData": {
    "BackgroundWarmup": true,
    "RefreshGeoOnStartup": false,
    "SyncEmbeddedOnStartup": true,
    "CacheLiveSearchResults": false,
    "GeoRefreshHours": 24,
    "CatalogRefreshHours": 24,
    "RefreshAllHsChapters": false,
    "MaxInMemoryCatalog": 800,
    "CatalogSeedQueries": []
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5003",
      "https://localhost:7126"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "TradeEaseDemoSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "TradeEase",
    "Audience": "TradeEaseClient"
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY_HERE",
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY_HERE"
  }
}




