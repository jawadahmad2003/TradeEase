@model IEnumerable<TradeEase.Models.Entities.Document>
@{ ViewData["Title"] = "Documents"; }
<div class="card"><div class="card-header"><h3 class="card-title">Documents</h3></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>Name</th><th>Type</th><th>Shipment</th><th>Date</th></tr></thead><tbody>
@foreach (var d in Model) { <tr><td>@d.DocumentName</td><td>@d.DocumentType</td><td>@d.Shipment?.ShipmentReference</td><td>@d.UploadedAt.ToString("dd-MMM-yyyy")</td></tr> }
@if (!Model.Any()) { <tr><td colspan="4" class="text-muted text-center py-4">No documents.</td></tr> }
</tbody></table></div></div>
