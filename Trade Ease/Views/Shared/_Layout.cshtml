@{
    var isAdmin = ViewData["IsAdminArea"] as bool? == true || User.IsAdmin();
    var title = ViewData["Title"]?.ToString() ?? "TradeEase";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - TradeEase</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tradeease.css" asp-append-version="true" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="bi bi-list"></i></a></li>
                <li class="nav-item d-none d-sm-inline-block"><span class="nav-link fw-bold">@title</span></li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><span class="nav-link">@User.Identity?.Name</span></li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link nav-link">Logout</button>
                    </form>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="#" class="brand-link">
                <span class="brand-text fw-bold ms-2">TradeEase</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                        @if (isAdmin)
                        {
                            <li class="nav-header">MANAGEMENT</li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Portal" asp-action="Index"><i class="nav-icon bi bi-grid"></i><p>Control Portal</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="nav-icon bi bi-people"></i><p>User Management</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Shipments" asp-action="Index"><i class="nav-icon bi bi-box-seam"></i><p>All Shipments</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="HSCodes" asp-action="Index"><i class="nav-icon bi bi-hash"></i><p>HS Tariff Admin</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Schemes" asp-action="Index"><i class="nav-icon bi bi-check2-square"></i><p>Scheme Rules</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="System" asp-action="Index"><i class="nav-icon bi bi-gear"></i><p>System Settings</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="nav-icon bi bi-bar-chart"></i><p>Reports</p></a></li>
                        }
                        else
                        {
                            <li class="nav-header">MAIN</li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="nav-icon bi bi-speedometer2"></i><p>Dashboard</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="TradeParties" asp-action="Index"><i class="nav-icon bi bi-people"></i><p>Trade Parties</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Shipments" asp-action="Index"><i class="nav-icon bi bi-box-seam"></i><p>Shipments</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Documents" asp-action="Index"><i class="nav-icon bi bi-file-earmark-text"></i><p>Documents</p></a></li>
                            <li class="nav-header">TOOLS</li>
                            <li class="nav-item"><a class="nav-link" asp-controller="HSCodes" asp-action="Index"><i class="nav-icon bi bi-hash"></i><p>HS Codes & Duty</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Forex" asp-action="Index"><i class="nav-icon bi bi-graph-up"></i><p>Forex Rates</p></a></li>
                            <li class="nav-header">COMPLIANCE</li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Compliance" asp-action="Index"><i class="nav-icon bi bi-shield-check"></i><p>Compliance Wizard</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Schemes" asp-action="Index"><i class="nav-icon bi bi-check2-square"></i><p>Scheme Checker</p></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="nav-icon bi bi-person"></i><p>Profile</p></a></li>
                        }
                    </ul>
                </nav>
            </div>
        </aside>
    }

    <div class="@(User.Identity?.IsAuthenticated == true ? "content-wrapper" : "")">
        <section class="@(User.Identity?.IsAuthenticated == true ? "content pt-3" : "")">
            <div class="@(User.Identity?.IsAuthenticated == true ? "container-fluid" : "")">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @RenderBody()
            </div>
        </section>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
