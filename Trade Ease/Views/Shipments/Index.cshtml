@model IEnumerable<TradeEase.Models.Entities.Shipment>
@{
    ViewData["Title"] = "Shipments";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">My Shipments</h3></div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>Reference</th><th>Type</th><th>Product</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ShipmentReference</td>
                    <td>@s.ShipmentType</td>
                    <td>@s.ProductDesc</td>
                    <td><span class="badge bg-info">@s.ShipmentStatus</span></td>
                    <td><a asp-action="Details" asp-route-id="@s.ShipmentReference" class="btn btn-sm btn-outline-primary">View</a></td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No shipments found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
