@model TradeEase.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In - TradeEase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tradeease.css" asp-append-version="true" />
</head>
<body class="auth-page">
<div class="auth-card card shadow-sm p-4">
    <div class="text-center mb-4">
        <div class="rounded bg-success text-white d-inline-flex align-items-center justify-content-center mb-2" style="width:48px;height:48px;font-weight:700;">TE</div>
        <h1 class="h4 mb-1">TradeEase</h1>
        <p class="text-muted small">Pakistan Import/Export ERP</p>
    </div>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="admin@tradeease.pk" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign In</button>
    </form>
    <p class="text-center small mt-3 mb-0">
        <a asp-action="Register">Create trader account</a>
    </p>
    <p class="text-muted text-center small mt-2 mb-0">Demo: admin@tradeease.pk → Admin</p>
</div>
</body>
</html>
