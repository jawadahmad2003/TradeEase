@model TradeEase.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="row">
    <div class="col-md-3"><div class="card card-te"><div class="card-body"><div class="text-muted small">Total Shipments</div><div class="stat-value">@Model.TotalShipments</div></div></div></div>
    <div class="col-md-3"><div class="card card-te"><div class="card-body"><div class="text-muted small">Pending</div><div class="stat-value">@Model.PendingShipments</div></div></div></div>
    <div class="col-md-3"><div class="card card-te"><div class="card-body"><div class="text-muted small">Cleared</div><div class="stat-value">@Model.ClearedShipments</div></div></div></div>
    <div class="col-md-3"><div class="card card-te"><div class="card-body"><div class="text-muted small">Trade Value (PKR)</div><div class="stat-value">@Model.TotalTradeValue.ToString("N0")</div></div></div></div>
</div>

<div class="row mt-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Recent Shipments</h3></div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead><tr><th>Reference</th><th>Product</th><th>Status</th><th>Value (PKR)</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.RecentShipments)
                    {
                        <tr>
                            <td>@s.Reference</td>
                            <td>@s.ProductDesc</td>
                            <td><span class="badge bg-info">@s.Status</span></td>
                            <td>@(s.TotalValuePKR?.ToString("N0") ?? "—")</td>
                        </tr>
                    }
                    @if (!Model.RecentShipments.Any())
                    {
                        <tr><td colspan="4" class="text-muted text-center py-4">No shipments yet. Run database seed or create one.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Forex Snapshot</h3></div>
            <div class="card-body">
                @foreach (var f in Model.ForexRates)
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span>@f.CurrencyCode/PKR</span><strong>@f.ExchangeRate.ToString("N2")</strong></div>
                }
                @if (!Model.ForexRates.Any())
                {
                    <p class="text-muted mb-0">No rates in database.</p>
                }
            </div>
        </div>
    </div>
</div>
