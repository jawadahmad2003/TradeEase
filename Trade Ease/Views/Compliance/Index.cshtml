@model IEnumerable<TradeEase.Models.Entities.ComplianceStep>
@{ ViewData["Title"] = "Compliance Wizard"; var progress = ViewBag.Progress as Dictionary<int, TradeEase.Models.Entities.UserComplianceProgress>; }
@foreach (var step in Model) {
    var done = progress?.ContainsKey(step.StepId) == true && progress[step.StepId].IsCompleted;
    <div class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center">
        <div><strong>@step.StepOrder. @step.StepName</strong><div class="text-muted small">@step.EstimatedTime</div></div>
        <span class="badge @(done ? "bg-success" : "bg-secondary")">@(done ? "Completed" : "Pending")</span>
    </div></div>
}
